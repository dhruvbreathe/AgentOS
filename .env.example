# AgentOS environment — copy to `.env` and fill in the blanks.

# --- Discord ---------------------------------------------------------------

# Default Discord bot token (used by every agent that doesn't pin its own).
# Create at https://discord.com/developers/applications → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# Discord guild (server) ID. Right-click your server → Copy Server ID.
# (Enable Developer Mode in Discord settings → Advanced to see the option.)
DISCORD_GUILD_ID=

# Per-agent bot tokens (optional — give an agent its own Discord identity).
# agent.yaml references these via `bot_token_env: MY_AGENT_BOT_TOKEN`.
# MAIN_BOT_TOKEN=
# EXAMPLE_BOT_TOKEN=

# Per-agent webhook URLs. Channel → Edit → Integrations → Webhooks → New.
# Naming convention: <AGENT_NAME_UPPER>_WEBHOOK_URL.
# agent.yaml references these via `webhook_url_env: MAIN_WEBHOOK_URL`.
MAIN_WEBHOOK_URL=
# EXAMPLE_WEBHOOK_URL=

# --- Memory layer ----------------------------------------------------------

# Shared memory root. Every agent's cwd defaults to this directory, so
# Claude's built-in Read/Write/Glob/Grep tools ARE the memory layer.
# Point it at any directory — an Obsidian vault works well but isn't required.
VAULT_PATH=/absolute/path/to/your/vault

# --- Dashboard (optional) --------------------------------------------------

# Basic-auth username for the web dashboard (scripts/launch_dashboard.sh).
# Password is auto-generated on first launch into logs/dashboard-creds.txt.
# DASHBOARD_USER=agentos
