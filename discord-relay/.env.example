# Default Discord bot token (used by agents that don't specify their own).
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Per-agent bot tokens (optional — give an agent its own Discord identity).
# agent.yaml points at these via `bot_token_env: PM_BOT_TOKEN`.
# PM_BOT_TOKEN=
# MARKETING_BOT_TOKEN=

# Per-agent webhook URLs (one per agent that wants outbound posting).
# Naming convention: <AGENT_NAME_UPPER>_WEBHOOK_URL
# agent.yaml references these via `webhook_url_env: MAIN_WEBHOOK_URL`.
MAIN_WEBHOOK_URL=
# PM_WEBHOOK_URL=
# MARKETING_WEBHOOK_URL=

# Obsidian vault (shared memory root)
VAULT_PATH=/Users/celainc/Documents/Vayu/Vayu
