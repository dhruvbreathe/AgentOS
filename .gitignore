# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# Dashboard basic-auth creds (auto-generated on first launch)
logs/dashboard-creds.txt

# Certs and keys
certs/
*.key
*.pem
*.crt

# ── Runtime state ─────────────────────────────────────────────────────────
logs/
.mcp_data/

# Private operator content. Only `_template/` ships with the public repo;
# every other agent directory is considered private (channel IDs, webhook env
# names, org-specific integrations, accumulated memory/learnings). Operators
# can selectively un-ignore any agent they want to publish as an example.
agents/*/
!agents/_template/

# Trajectory logs
logs/trajectories/

# ── Vendored / local-only ─────────────────────────────────────────────────
# SDK clone used as reference during development; install via pip instead.
claude-agent-sdk-python/

# Local Vercel proxy scratch
vercel-proxy/.vercel/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/

# ── Editor / OS ───────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ── Claude Code workspace cruft ───────────────────────────────────────────
.claude/
